# Generated by TraceLean. The lockfile, the policy, the DRT config and the
# replay corpus are the parts that belong in version control; sessions, caches
# and build output do not.
.tracelean/*
!.tracelean/trace.lock.json
!.tracelean/trace_policy.json
!.tracelean/drt.json

# The generated Lean runner and its build output are regenerated by
# `drt_build_runner` and are large; the seed corpus is neither. A divergence
# that was found once is worth replaying forever, which only works if the
# witness travels with the repository.
!.tracelean/drt/
.tracelean/drt/*
!.tracelean/drt/seeds/

__pycache__/
audit.log
formal/.lake/
