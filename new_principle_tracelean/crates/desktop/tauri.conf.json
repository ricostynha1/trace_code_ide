{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraceLean",
  "version": "0.1.0",
  "identifier": "dev.tracelean.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TraceLean",
        "width": 1000,
        "height": 700,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
